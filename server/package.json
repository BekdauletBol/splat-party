{
  "name": "@splat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --alias:@splat/shared=../shared/src/index.ts --outfile=dist/index.js --tsconfig=tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.0",
    "@dimforge/rapier3d-compat": "^0.19.0",
    "@splat/shared": "*",
    "colyseus": "^0.16.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
